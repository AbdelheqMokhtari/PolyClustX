# Python
__pycache__/
*.py[cod]
*.egg-info/
/build/
/dist/
/.venv/

# Tooling caches
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
/htmlcov/
/test-results.xml
.ipynb_checkpoints/

# Generated documentation and local screenshots
/docs/_build/
/docs/_static/screenshots/

# Local credentials; example environment files may be versioned.
.env
.env.*
!.env.example

# Local data, experiment output and scratch notes
# Keep these anchored to the repository root so source packages such as
# src/polyclustx/data are never ignored accidentally.
/data/
/*.mat
/experiments/
/notebooks/experiments/
/logs/
/src/polyclustx/configs/*.local.yaml
/START.md
/FINDING.md
/to_do_list.md
/deployment.md

# Standalone reference implementations, never the integrated model packages.
/SCM/
/IDEC/
/Completer/
/DCP/
/MFLVC/
/conan/
/DGF/
/G-CoMVKM/
/SGLA/
/UMC/
/GMVC/

# Manuscripts and reference papers are maintained separately from the library.
/paper/
